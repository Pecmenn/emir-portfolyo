  "process": {
    "title": {
      "tr": "Nasıl\nçalışırım",
      "en": "How\nI work"
    },
    "text": {
      "tr": "Her işte aynı dört adım; hangisinden başlayacağımızı ihtiyacın belirler.",
      "en": "The same four steps every time; your needs decide where we start."
    },
    "steps": [
      {
        "title": {
          "tr": "Dinlerim",
          "en": "Listen"
        },
        "text": {
          "tr": "Hedefi, kitleyi ve elindeki malzemeyi birlikte netleştiririz.",
          "en": "We clarify the goal, the audience and what you already have."
        }
      },
      {
        "title": {
          "tr": "Tasarlarım",
          "en": "Design"
        },
        "text": {
          "tr": "Ekranları ve görselleri hazırlar, onayına sunarım.",
          "en": "I prepare the screens and visuals for your approval."
        }
      },
      {
        "title": {
          "tr": "Kurarım",
          "en": "Build"
        },
        "text": {
          "tr": "Onaylanan tasarımı kodlar, yayına alırım.",
          "en": "I code the approved design and launch it."
        }
      },
      {
        "title": {
          "tr": "Otomatikleştiririm",
          "en": "Automate"
        },
        "text": {
          "tr": "Tekrar eden işleri sisteme devreder, kullanımını anlatırım.",
          "en": "I hand repetitive work to the system and show you how to use it."
        }
      }
    ]
  }
